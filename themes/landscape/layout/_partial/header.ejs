<header id="header">
  <div id="banner"></div>
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <h1 id="logo-wrap">
        <a href="<%- url_for() %>" id="logo"><%= config.title %></a>
      </h1>
      <% if (theme.subtitle){ %>
        <h2 id="subtitle-wrap">
          <a href="<%- url_for() %>" id="subtitle"><%= theme.subtitle %></a>
        </h2>
      <% } %>
    </div>
    <div id="header-inner" class="inner">
      <nav id="main-nav">
        <a id="main-nav-toggle" class="nav-icon"></a>
        <a class="main-nav-link" href="//solome.js.org/">首页</a>

        <% for (var i in theme.menu){ %>
          <a class="main-nav-link" href="<%- url_for(theme.menu[i]) %>"><%= i %></a>
        <% } %>
        <a class="main-nav-link" href="//solome.js.org/slides">Slides</a>
        <!-- <a class="main-nav-link" href="//solome.js.org/storybook">Storybook</a> -->

      </nav>
      <nav id="sub-nav">
        <div id="theme-switcher" class="theme-switcher">
          <button class="theme-switcher-toggle" type="button" aria-label="切换主题" aria-haspopup="listbox" aria-expanded="false"></button>
          <div class="theme-switcher-menu" role="listbox" aria-label="主题">
            <button class="theme-option" type="button" role="option" data-theme-value="lake-mist" data-theme-label="湖岚青">
              <span class="theme-swatch theme-swatch-lake" aria-hidden="true"></span>
              <span>湖岚青</span>
            </button>
            <button class="theme-option" type="button" role="option" data-theme-value="sakura-gray-pink" data-theme-label="樱灰粉">
              <span class="theme-swatch theme-swatch-sakura" aria-hidden="true"></span>
              <span>樱灰粉</span>
            </button>
          </div>
        </div>
        <% if (theme.rss){ %>
          <!-- <a id="nav-rss-link" class="nav-icon" href="<%- url_for(theme.rss) %>" title="<%= __('rss_feed') %>"></a> -->
        <% } %>
        <!-- <a id="nav-search-btn" class="nav-icon" title="<%= __('search') %>"></a> -->
      </nav>
      <!-- <div id="search-form-wrap">
        <%- search_form({button: '&#xF002;'}) %>
      </div> -->
    </div>
  </div>
</header>
