.archives-wrap
  margin: block-margin 0

.archives
  clearfix()

.archive-year-wrap
  margin-bottom: 1em

.archive-year
  @extend $block-caption
  color: var(--color-shell-text-muted)
  text-shadow: none

.archives
  column-gap: 10px
  @media mq-tablet
    column-count: 2
  @media mq-normal
    column-count: 3

.archive-article
  avoid-column-break()

.archive-article-inner
  @extend $block
  padding: 10px
  margin-bottom: 15px
  background-color: var(--color-surface)

.archive-article-title
  text-decoration: none
  font-weight: bold
  transition: color 0.2s
  line-height: line-height
  color: var(--color-link)
  &:hover
    color: var(--color-link-hover)
    border-bottom: 1px dashed var(--color-link-hover)

.archive-article-footer
  margin-top: 1em

.archive-article-date
  color: var(--color-text-faint)
  text-decoration: none
  font-size: 0.85em
  line-height: 1.5em
  margin-bottom: 0.5em
  display: block

#page-nav
  clearfix()
  margin: block-margin auto
  background: var(--color-surface)
  border: 1px solid var(--color-border)
  border-radius: 3px
  text-align: center
  color: var(--color-text-faint)
  overflow: hidden
  a, span
    padding: 10px 20px
    line-height: 20px
    height: 20px
  a
    color: var(--color-text-faint)
    text-decoration: none
    &:hover
      background: var(--color-accent)
      font-weight: 500
      color: var(--color-surface)
  .prev
    float: left
  .next
    float: right
  .page-number
    display: inline-block
    @media mq-mobile
      display: none
  .current
    color: var(--color-link)
    font-weight: bold
  .space
    color: var(--color-border)
