#header
  height: banner-height
  position: relative
  &:before
    content: ""
    position: absolute
    left: 0
    right: 0
    height: 64px
  &:before
    top: 0
    background: linear-gradient(rgba(0, 0, 0, 0.125), transparent)

#header-outer
  height: 100%
  position: relative

#header-inner
  position: relative

#banner
  display: none
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: url(banner-url) center #000
  background-size: cover
  z-index: -1

#header-title
  text-align: center
  height: logo-size
  position: absolute
  top: 50%
  left: 0
  margin-top: logo-size * -0.5

$logo-text
  text-decoration: none
  color: var(--color-surface)
  font-weight: 300
  text-shadow: 0 1px 4px var(--color-soft-shadow)

#logo-wrap
  text-align: left;
  padding: 58px 0 0 20px;

#logo
  @extend $logo-text
  font-size: 32px
  line-height: logo-size
  letter-spacing: 2px
  font-family: 'source han serif',  "Lato","Helvetica Neue", Helvetica, sans-serif;
  color: var(--color-brand)
  font-weight: 800;

#subtitle
  @extend $logo-text
  font-size: subtitle-size
  line-height: subtitle-size
  letter-spacing: 1px

#subtitle-wrap
  margin-top: subtitle-size

#main-nav
  float: left
  margin-left: -15px
  overflow: visible;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, sans-serif, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";

$nav-link
  float: left
  color: var(--color-surface)
  opacity: var(--opacity-nav)
  text-decoration: none
  text-shadow: 0 1px var(--color-soft-shadow)
  transition: opacity 0.2s
  display: block
  padding: 20px 15px
  &:hover
    opacity: 1
    color: var(--color-nav-hover)

.nav-icon
  @extend $nav-link
  font-family: font-icon
  text-align: center
  font-size: font-size
  width: font-size
  height: font-size
  padding: 20px 15px
  position: relative
  cursor: pointer

.main-nav-link
  @extend $nav-link
  font-weight: 300
  letter-spacing: 1px
  color: var(--color-nav)
  @media mq-mobile
    display: none

#main-nav-toggle
  display: none
  &:before
    content: "\f0c9"
  @media mq-mobile
    display: block

#sub-nav
  float: right
  margin-right: -15px

.theme-switcher
  float: left
  position: relative
  padding: 17px 0
  font-family: font-self
  @media screen and (max-width: 760px)
    display: none

.theme-switcher-toggle
  display: block
  width: 22px
  height: 22px
  padding: 0
  border: 0
  border-radius: 0
  background: transparent
  color: var(--color-theme-control-text)
  font: 12px font-self
  line-height: 1
  cursor: pointer
  opacity: 0.48
  transition: opacity 0.2s, border-color 0.2s, color 0.2s, background-color 0.2s
  &:before
    content: "\f042"
    display: block
    font: 16px font-icon
    line-height: 22px
    text-align: center
  &:hover,
  &:focus
    opacity: 0.86
    color: var(--color-nav)
    background: transparent
    outline: none

.theme-switcher-menu
  display: none
  position: absolute
  top: 45px
  right: 0
  z-index: 5
  min-width: 116px
  padding: 6px
  border: 1px solid var(--color-theme-control-border)
  border-radius: 8px
  background: var(--color-theme-control-menu-background)
  backdrop-filter: blur(10px)
  box-shadow: 0 8px 20px var(--color-theme-menu-shadow)

.theme-switcher.is-open
  .theme-switcher-menu
    display: block

.theme-option
  display: flex
  align-items: center
  gap: 8px
  width: 100%
  padding: 7px 8px
  border: 0
  border-radius: 6px
  background: transparent
  color: var(--color-theme-control-text)
  font: 12px font-self
  text-align: left
  cursor: pointer
  white-space: nowrap
  &:hover,
  &:focus
    background: var(--color-theme-control-hover-background)
    color: var(--color-text-strong)
    outline: none
  &.is-active
    color: var(--color-text-strong)
    font-weight: 600

.theme-swatch
  width: 13px
  height: 13px
  border-radius: 50%
  border: 1px solid var(--color-theme-control-border)
  flex: 0 0 auto
  box-shadow: inset 0 0 0 2px var(--color-surface)

.theme-swatch-lake
  background: linear-gradient(135deg, #e5f1f8 0 49%, #258fb8 50% 100%)

.theme-swatch-sakura
  background: linear-gradient(135deg, #4A3F4B 0 49%, #F0D9E4 50% 100%)

#nav-rss-link
  &:before
    content: "\f09e"

#nav-search-btn
  &:before
    content: "\f002"

#search-form-wrap
  position: absolute
  top: 15px
  width: 150px
  height: 30px
  right: -150px
  opacity: 0
  transition: 0.2s ease-out
  &.on
    opacity: 1
    right: 0
  @media mq-mobile
    width: 100%
    right: -100%

.search-form
  position: absolute
  top: 0
  left: 0
  right: 0
  background: var(--color-surface)
  padding: 5px 15px
  border-radius: 15px
  box-shadow: 0 0 10px var(--color-soft-shadow)

.search-form-input
  border: none
  background: none
  color: var(--color-text)
  width: 100%
  font: 13px font-sans
  outline: none
  &::-webkit-search-results-decoration
  &::-webkit-search-cancel-button
    -webkit-appearance: none

.search-form-submit
  position: absolute
  top: 50%
  right: 10px
  margin-top: -7px
  font: 13px font-icon
  border: none
  background: none
  color: var(--color-text-faint)
  cursor: pointer
  &:hover, &:focus
    color: var(--color-text-muted)
