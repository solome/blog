.article
  margin: block-margin 0
  color: var(--color-text)
.article
  span.caption
    display: none !important;

.article-inner
  @extend $block
  background-color: var(--color-surface)
  overflow: hidden

.article-meta
  clearfix()

.article-date
  @extend $block-caption
  float: left
.article-dateref
  font-size: .8rem;
  line-height: 2;
  color: var(--color-text-muted)
  padding-top: 6px;

.article-category
  float: left
  line-height: 1em
  color: var(--color-text-faint)
  text-shadow: 0 1px var(--color-text-shadow)
  margin-left: 8px
  &:before
    content: "\2022"

.article-category-link
  @extend $block-caption
  margin: 0 12px 1em

.article-header
  padding: article-padding article-padding 0 article-padding

.article-title
  text-decoration: none
  font-size: 2em
  font-weight: bold
  color: var(--color-text-strong)
  line-height: line-height-title
  transition: color 0.2s
  a&:hover
    color: var(--color-link)

.article-entry
  @extend $base-style
  clearfix()
  color: var(--color-text)
  padding: 0 article-padding
  p, table
    line-height: line-height
    margin: 1em 0
  h1, h2, h3, h4, h5, h6
    font-weight: bold
  h1, h2, h3, h4, h5, h6
    line-height: line-height-title
    margin: line-height-title 0
  h1, h2
    color: var(--color-text-strong)
  h3
    color: var(--color-accent)
  h4
    color: var(--color-link)
  strong
    color: var(--color-text-strong)
  a
    background-color: var(--color-link-background)
    border-bottom: 1px solid var(--color-border)
    color: var(--color-link)
    text-decoration: none
    &:hover
      background-color: var(--color-link-background-hover)
      border-bottom-color: var(--color-link-hover)
      color: var(--color-link-hover)
  img, video
    max-width: 100%
    height: auto
    display: block
    margin: auto
  iframe
    border: none
  figure
    text-align: center
    figcaption
      padding: 10px 0 0 0;
      font-size: 14px;
      color: var(--color-text-muted)
    a
      background: none;
      border: none;
    a:hover
      background: none;
      border: none;
  table
    width: 100%
    border-collapse: collapse
    border-spacing: 0
  th
    font-weight: bold
    border-bottom: 3px solid var(--color-border)
    padding-bottom: 0.5em
  td
    border-bottom: 1px solid var(--color-border)
    padding: 10px 0
  blockquote
    margin: 12px 0 0 0;
    background: var(--color-quote-background)
    padding: 10px 15px;
    color: var(--color-quote-text)
    background-color: var(--color-quote-background)
    border-left-color: var(--color-quote-border)
    border-left: 8px solid var(--color-quote-border)
    p
      margin 0
    footer
      font-size: font-size
      margin: line-height 0
      font-family: font-sans
      cite
        &:before
          content: "—"
          padding: 0 0.5em
  .pullquote
    text-align: left
    width: 45%
    margin: 0
    &.left
      margin-left: 0.5em
      margin-right: 1em
    &.right
      margin-right: 0.5em
      margin-left: 1em
  .caption
    color: var(--color-text-faint)
    display: block
    font-size: 0.9em
    margin-top: 0.5em
    position: relative
    text-align: center
  // http://webdesignerwall.com/tutorials/css-elastic-videos
  .video-container
    position: relative
    padding-top: (9 / 16 * 100)% // 16:9 ratio
    height: 0
    overflow: hidden
    iframe, object, embed
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
      margin-top: 0

.article-more-link a
  display: inline-block
  line-height: 1em
  padding: 6px 15px
  border-radius: 15px
  background: var(--color-shell-background)
  color: var(--color-text-faint)
  text-shadow: 0 1px var(--color-text-shadow)
  text-decoration: none
  &:hover
    background: var(--color-link)
    color: var(--color-surface)
    text-decoration: none
    text-shadow: none

.article-footer
  clearfix()
  font-size: 0.85em
  line-height: line-height
  border-top: 1px solid var(--color-border)
  padding-top: line-height
  margin: 0 article-padding article-padding
  a
    color: var(--color-text-faint)
    text-decoration: none
    &:hover
      color: var(--color-text)

.article-tag-list-item
  float: left
  margin-right: 10px

.article-tag-list-link
  &:before
    content: "#"

.article-comment-link
  float: right
  &:before
    content: "\f075"
    font-family: font-icon
    padding-right: 8px

.article-share-link
  cursor: pointer
  float: right
  margin-left: 20px
  &:before
    content: "\f064"
    font-family: font-icon
    padding-right: 6px

#article-nav
  clearfix()
  position: relative
  @media mq-normal
    margin: block-margin 0
    &:before
      absolute-center(8px)
      content: ""
      border-radius: 50%
      background: var(--color-accent)
      box-shadow: 0 1px 2px var(--color-text-shadow)

.article-nav-link-wrap
  text-decoration: none
  text-shadow: 0 1px var(--color-text-shadow)
  color: var(--color-text-faint)
  box-sizing: border-box
  margin-top: block-margin
  text-align: center
  display: block
  &:hover
    color: var(--color-text)
  @media mq-normal
    width: 50%
    margin-top: 0

#article-nav-newer
  @media mq-normal
    float: left
    text-align: right
    padding-right: 20px

#article-nav-older
  @media mq-normal
    float: right
    text-align: left
    padding-left: 20px

.article-nav-caption
  text-transform: uppercase
  letter-spacing: 2px
  line-height: 1em
  font-size: 16px
  color: var(--color-text-muted)
  #article-nav-newer &
    margin-right: -2px

.article-nav-title
  color: var(--color-accent)
  line-height: line-height
  margin-top: 0.5em
  &:hover
    color: var(--color-link-hover)
    text-decoration-style: dashed
    text-decoration-line: underline

.article-share-box
  position: absolute
  display: none
  background: var(--color-surface)
  margin-left: -145px
  overflow: hidden
  z-index: 1
  &.on
    display: block

.article-share-input
  width: 100%
  background: none
  box-sizing: border-box
  font: 14px font-sans
  padding: 0 15px
  color: var(--color-text)
  outline: none
  border: 1px solid var(--color-border)
  border-radius: 3px 3px 0 0
  height: 36px
  line-height: 36px

.article-share-links
  clearfix()
  background: var(--color-shell-background)
  display: flex;
  justify-content: space-between;

$article-share-link
  width: 50px
  height: 36px
  display: block
  float: left
  position: relative
  color: var(--color-text-faint)
  text-shadow: 0 1px var(--color-text-shadow)
  &:before
    font-size: 20px
    font-family: font-icon
    absolute-center(@font-size)
    text-align: center
  &:hover
    color: var(--color-surface)

.article-share-twitter
  @extend $article-share-link
  &:before
    content: "\f099"
  &:hover
    background: color-twitter
    text-shadow: 0 1px darken(color-twitter, 20%)

.article-share-facebook
  @extend $article-share-link
  &:before
    content: "\f09a"
  &:hover
    background: color-facebook
    text-shadow: 0 1px darken(color-facebook, 20%)

.article-share-pinterest
  @extend $article-share-link
  &:before
    content: "\f0d2"
  &:hover
    background: color-pinterest
    text-shadow: 0 1px darken(color-pinterest, 20%)

.article-share-google
  @extend $article-share-link
  &:before
    content: "\f0d5"
  &:hover
    background: color-google
    text-shadow: 0 1px darken(color-google, 20%)

.article-gallery
  background: #000
  position: relative

.article-gallery-photos
  position: relative
  overflow: hidden

.article-gallery-img
  display: none
  max-width: 100%
  &:first-child
    display: block
  &.loaded
    position: absolute
    display: block
  img
    display: block
    max-width: 100%
    margin: 0 auto
