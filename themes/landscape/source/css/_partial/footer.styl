#footer
  padding: 50px 0
  margin: 0 50px
  border-top: 1px solid var(--color-border)
  color: var(--color-shell-text-muted)
  font-size: 16px
  a
    color: var(--color-shell-link)
    text-decoration: none
    &:hover
      border-bottom: 1px dashed var(--color-shell-link-hover)
      color: var(--color-shell-link-hover)


#footer-info
  line-height: line-height
  font-size: 0.85em
