#sidebar
  @media mq-normal
    column(sidebar-column)

.widget-wrap
  margin: block-margin 0

.widget-title
  @extend $block-caption
  color: var(--color-shell-text-muted)
  text-shadow: none

.widget
  color: var(--color-shell-text-muted)
  text-shadow: none
  padding: 15px
  background: var(--color-shell-panel-background)
  border-radius: 3px
  a
    color: var(--color-shell-link)
    text-decoration: none
    &:hover
      color: var(--color-shell-link-hover)
      border-bottom: 1px dashed var(--color-shell-link-hover)
  ul, ol, dl
    ul, ol, dl
      margin-left: 15px
      list-style: disc
      font-size: 14px
  li
    margin-bottom: 8px
